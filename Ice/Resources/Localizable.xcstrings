          "stringUnit": {
            "state": "translated",
            "value": "2"
          }
        }
      }
    },
    "3": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會收集或儲存任何個人資訊。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致謝"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階"
          }
        }
      }
    },
    "Always-Hidden": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠隱藏"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用"
          }
        }
      }
    },
    "Apply different settings based on the current system appearance.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照目前的系統外觀套用不同的設定。"
          }
        }
      }
    },
    "Apply the current spacing": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用目前的間距"
          }
        }
      }
    },
    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用此設定會重新啟動所有帶有選單列項目的 App。部分 App 可能需要手動重新啟動。"
          }
        }
      }
    },
    "Arrange menu bar items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列選單列項目。"
          }
        }
      }
    },
    "Arrow": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "箭頭"
          }
        }
      }
    },
    "Automatically rehide": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動重新隱藏"
          }
        }
      }
    },
    "BETA": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BETA"
          }
        }
      }
    },
    "Border": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊框"
          }
        }
      }
    },
    "Border Color": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊框顏色"
          }
        }
      }
    },
    "Border Width": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊框寬度"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Change the menu bar's appearance.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改選單列的外觀。"
          }
        }
      }
    },
    "Chevron": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尖角"
          }
        }
      }
    },
    "Choose a custom icon to show in the menu bar.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要顯示在選單列的自訂圖像。"
          }
        }
      }
    },
    "Choose image…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇影像⋯"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Click inside an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列的空白區域來顯示隱藏的選單列項目。"
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access Ice's settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下來顯示隱藏的選單列項目。按右鍵來打開 Ice 的設定。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "Continue in Limited Mode": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以受限模式繼續"
          }
        }
      }
    },
    "Custom": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂"
          }
        }
      }
    },
    "Custom icon uses dynamic appearance": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂圖像使用動態外觀"
          }
        }
      }
    },
    "Dark Appearance": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色外觀"
          }
        }
      }
    },
    "Display images of individual menu bar items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示個別選單列項目的影像。"
          }
        }
      }
    },
    "Display the icon as a monochrome image that dynamically adjusts to match the menu bar's appearance. This setting removes all color from the icon, but ensures consistent rendering with both light and dark backgrounds.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將圖像顯示為單色影像，並動態調整以配合選單列的外觀。此設定會移除圖像的所有顏色，但能確保在淺色與深色背景上都顯示一致。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Door": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "門"
          }
        }
      }
    },
    "Dot": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓點"
          }
        }
      }
    },
    "Drag to arrange your menu bar items into different sections.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移來將選單列項目排列到不同區段。"
          }
        }
      }
    },
    "Due to a bug in a previous version of the app, the data for Ice’s menu bar sections was corrupted and had to be reset.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於先前版本的錯誤，Ice 的選單列區段資料已損毀並已重置。"
          }
        }
      }
    },
    "Dynamic": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態"
          }
        }
      }
    },
    "ERROR": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤"
          }
        }
      }
    },
    "Edit Menu Bar Appearance…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯選單列外觀⋯"
          }
        }
      }
    },
    "Ellipsis": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "省略號"
          }
        }
      }
    },
    "Enable secondary context menu": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用次要快顯選單"
          }
        }
      }
    },
    "Enable the Ice Bar": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Ice Bar"
          }
        }
      }
    },
    "Enable the always-hidden section": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用永遠隱藏區段"
          }
