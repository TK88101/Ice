    },
    "Focused app": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的 App"
          }
        }
      }
    },
    "Full": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整"
          }
        }
      }
    },
