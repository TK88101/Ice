    "Gradient": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漸層"
          }
        }
      }
    },
    "Grant Permission": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授與權限"
          }
        }
      }
    },
    "Hidden": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏"
          }
        }
      }
    },
    "Hidden: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已隱藏：%@"
          }
        }
      }
    },
    "Hide %@ Section": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起%@區段"
          }
        }
      }
    },
    "Hide app menus when showing menu bar items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示選單列項目時隱藏 App 選單"
          }
        }
      }
    },
    "Hiding did not take effect for %@ item(s)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 個項目未能隱藏"
          }
        }
      }
    },
    "Hold to Preview": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住以預覽"
          }
        }
      }
    },
    "Hotkey is reserved by macOS": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵已由 macOS 保留"
          }
        }
      }
    },
    "Hotkeys": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵"
          }
        }
      }
    },
    "Hover over an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標停在選單列的空白區域來顯示隱藏的選單列項目。"
          }
        }
      }
    },
    "Ice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice"
          }
        }
      }
    },
    "Ice Bar on macOS 27 shows app icons and opens items with a left click.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 27 上，Ice Bar 會顯示 App 圖像，按一下即可打開項目。"
          }
        }
      }
    },
    "Ice Bar: an item meant to be hidden is still drawn on the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar：應隱藏的項目仍顯示在選單列上。"
          }
        }
      }
    },
    "Ice Bar: getting ready to hide the chosen items.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar：正在準備隱藏所選項目。"
          }
        }
      }
    },
    "Ice Bar: hiding requested, not verified (%@).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar：已要求隱藏，尚未驗證（%@）。"
          }
        }
      }
    },
    "Ice Bar: nothing is left of Ice's divider, so nothing is hidden.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar：Ice 分隔線左側沒有任何項目，因此沒有隱藏任何東西。"
          }
        }
      }
    },
    "Ice Bar: the chosen items are hidden (checked).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar：所選項目已隱藏（已檢查）。"
          }
        }
      }
    },
    "Ice Cube": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "冰塊"
          }
        }
      }
    },
    "Ice Settings…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 設定⋯"
          }
        }
      }
    },
    "Ice can work in a limited mode without this permission.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有此權限時，Ice 可以在受限模式下運作。"
          }
        }
      }
    },
    "Ice cannot arrange menu bar items in automatically hidden menu bars.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法在自動隱藏的選單列中排列選單列項目。"
          }
        }
      }
    },
    "Ice cannot display menu bar items for automatically hidden menu bars": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法顯示自動隱藏的選單列中的項目"
          }
        }
      }
    },
    "Ice cannot edit the appearance of automatically hidden menu bars.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法編輯自動隱藏的選單列的外觀。"
          }
        }
      }
    },
    "Ice cannot tell %@ from another item of the same app, so it hides nothing. Hold Command and drag it to the right of Ice's divider.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法區分「%@」與同一 App 的其他項目，因此不會隱藏任何東西。請按住 Command 將它拖移到 Ice 分隔線的右側。"
          }
        }
      }
    },
    "Ice cannot tell %@ from another item of the same app, so it hides nothing. Hold Command and drag them to the right of Ice's divider.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法區分「%@」與同一 App 的其他項目，因此不會隱藏任何東西。請按住 Command 將它們拖移到 Ice 分隔線的右側。"
          }
        }
      }
    },
    "Ice could not read every menu bar item, so it hides nothing until it can.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法讀取所有選單列項目，因此在能讀取之前不會隱藏任何東西。"
          }
        }
      }
    },
    "Ice icon": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 圖像"
          }
        }
      }
    },
    "Ice needs this to:": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 需要此權限來："
          }
        }
      }
    },
    "Ice needs your permission to manage the menu bar.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 需要你的權限來管理選單列。"
          }
        }
      }
    },
    "Ice uses the new language after it relaunches.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 重新啟動後才會使用新的語言。"
          }
        }
      }
    },
    "Ice's hidden-section divider is not on the menu bar, so Ice hides nothing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 的隱藏區段分隔線不在選單列上，因此 Ice 不會隱藏任何東西。"
          }
        }
      }
    },
    "Ice's icon is left of its hidden-section divider, so Ice hides nothing. Hold Command and drag Ice's icon to the right of the divider.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 圖像位於隱藏區段分隔線的左側，因此 Ice 不會隱藏任何東西。請按住 Command 將 Ice 圖像拖移到分隔線的右側。"
          }
        }
      }
    },
    "Ice's icon is not on the menu bar, so Ice hides nothing. Turn on Show Ice icon, or make room for it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 圖像不在選單列上，因此 Ice 不會隱藏任何東西。請打開「顯示 Ice 圖像」，或為它騰出空間。"
          }
        }
      }
    },
    "Items can also be arranged by ⌘ Command + dragging them in the menu bar.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在選單列中按住 ⌘ Command 並拖移來排列項目。"
