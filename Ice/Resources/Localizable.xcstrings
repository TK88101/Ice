      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        }
      }
    },
    "Get real-time information about the menu bar.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得選單列的即時資訊。"
          }
        }
      }
    },
    "Go to Advanced Settings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往進階設定"
          }
        }
